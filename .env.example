[TEMPLATE]
# Copy this file to .env in the project root. Both the frontend and API read it.
# VITE_ variables are embedded in the browser build; only put public values there.
# Never put ADMIN_EMAILS or SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable.

# ---- App / API ----
PORT=4000
VITE_API_URL=

# Default map centre — Pune, Maharashtra, India (change to your own town/city)
MAP_CENTER_LAT=18.5204
MAP_CENTER_LNG=73.8567
MAP_ZOOM=13

# ---- Supabase Google sign-in (required for authentication) ----
# Project URL and anon/public key are safe to expose to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Supabase database (optional; omit service-role key to use local JSON) ----
# Use the service_role key only on the server. Never rename it with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin Google account emails; server-only.
ADMIN_EMAILS=

# ---- Google Sheets / Forms (optional) ----
# 1) URL of a Google Form you use to collect community data (shown in the UI)
GOOGLE_FORM_URL=
# 2) Web App URL of the Apps Script in google-apps-script.gs — lets the "Sync to Google Sheets"
#    button push new markers into a spreadsheet automatically.
GOOGLE_SHEETS_WEBHOOK_URL=
